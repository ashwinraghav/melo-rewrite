# Copy this file to terraform.tfvars (gitignored) for local overrides.
# CI/CD passes these as -var flags on `terraform apply`.

project_id     = "melo-f5756"
project_number = "888632552624"
region         = "us-central1"

# API image — set by deploy-api.sh on each deploy.
# Leave as default on first apply (uses placeholder "hello" image).
# api_image = "us-central1-docker.pkg.dev/melo-f5756/mello/api:latest"

# CORS — comma-separated. Includes Firebase Hosting + custom domain.
# cors_origins = "https://melo-f5756.web.app,https://melobooks.com,https://www.melobooks.com"

# audio_url_ttl_seconds = 900  # 15 minutes (default)

# Creator service API keys (required for story generation)
# anthropic_api_key  = "sk-ant-..."
# elevenlabs_api_key = "sk_..."
# elevenlabs_voice_id = "AXdMgz6evoL7OPd7eU12"  # default
# elevenlabs_model_id = "eleven_multilingual_v2"  # default
